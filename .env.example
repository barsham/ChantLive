# Required
DATABASE_URL=postgres://username:password@localhost:5432/chantlive
SESSION_SECRET=replace-with-a-long-random-string


# Optional server config
PORT=5000
NODE_ENV=development

# Transactional email: use a sender on your authenticated SendGrid domain.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=info@chantlive.online
SENDGRID_FROM_NAME=ChantLive
# Trusted origin for verification and password reset links.
PUBLIC_BASE_URL=http://localhost:5000
# Local development only; ignored when NODE_ENV is not development.
DEV_SKIP_EMAIL_VERIFICATION=false
