# Required
DATABASE_URL=postgres://username:password@localhost:5432/chantlive
SESSION_SECRET=replace-with-a-long-random-string


# Optional server config
PORT=5000
NODE_ENV=development

# Transactional email: use a sender on your authenticated SendGrid domain.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=info@chantlive.online
SENDGRID_FROM_NAME=ChantLive
# Trusted origin for verification and password reset links.
PUBLIC_BASE_URL=http://localhost:5000
# Local development only; ignored when NODE_ENV is not development.
DEV_SKIP_EMAIL_VERIFICATION=false
# Better Auth
# At least 32 random characters. Falls back to SESSION_SECRET for existing installs.
BETTER_AUTH_SECRET=
# Optional: verified owner of this email becomes super admin on initial signup.
# Existing roles are preserved. Remove after creating the initial account.
INITIAL_ADMIN_EMAIL=
# Number of trusted reverse proxy hops; 0 for direct connections.
# Set only to match your hosting topology so client rate limits cannot be spoofed.
TRUST_PROXY_HOPS=0
# Behind a local reverse proxy, bind only to loopback (production uses 127.0.0.1).
HOST=0.0.0.0
